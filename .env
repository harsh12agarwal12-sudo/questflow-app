# QUESTFLOW ENVIRONMENT CONFIGURATION
# PROMPTWars × OUTLIER'2026

# Google Cloud Console OAuth 2.0 Client ID (Web Application)
# Required scopes:
# 1. https://www.googleapis.com/auth/gmail.readonly
# 2. https://www.googleapis.com/auth/gmail.modify
# Authorized JavaScript Origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Default Operational Mode (true = Sandbox with realistic mock payloads, false = Live Production)
VITE_DEFAULT_DEMO_MODE=true

# Port configuration
PORT=5173
